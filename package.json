{
  "name": "safecommute-bvp",
  "version": "1.0.0",
  "private": true,
  "description": "SafeCommute BVP monorepo",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --workspace safecommute-bvp-api\" \"npm run dev --workspace safecommute-bvp-web\"",
    "dev:server": "npm run dev --workspace safecommute-bvp-api",
    "dev:client": "npm run dev --workspace safecommute-bvp-web",
    "build": "npm run build --workspace safecommute-bvp-web",
    "start": "npm run start --workspace safecommute-bvp-api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}